# ==============================================================================
# BHUVAN BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Configuration (PostgreSQL / Supabase Connection Pooler or Direct)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres

# Redis Configuration (Upstash or Redis URI, supports rediss:// for TLS)
REDIS_URL=rediss://default:[YOUR-UPSTASH-PASSWORD]@[YOUR-UPSTASH-ENDPOINT]:6379

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# CORS allowed origins (comma-separated for multiple origins, e.g. https://bhuvan.app)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security & Rate Limiting Rules
REPLAY_TOLERANCE_SECONDS=300
SLOT_10_COOLDOWN_HOURS=168

# Admin Command Center Security Key (CRITICAL: Change to high-entropy 64-char key in production!)
ADMIN_SECRET_KEY=bhuvan-sovereign-admin-key-change-in-production

# Storage Backend: "local" (default) or "s3" (AWS S3, Cloudflare R2, Supabase Storage)
STORAGE_BACKEND=local
# S3_BUCKET=bhuvan-broadcasts
# S3_ENDPOINT_URL=https://[account-id].r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=[your-access-key]
# S3_SECRET_ACCESS_KEY=[your-secret-key]
# S3_REGION=auto
# S3_PUBLIC_URL_PREFIX=https://cdn.bhuvan.app

# API Rate Limits (Requests per minute per IP)
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_FOLLOW_PER_MINUTE=30
RATE_LIMIT_BROADCAST_PER_MINUTE=20
