# Database Configuration (PostgreSQL / Supabase Connection Pooler or Direct)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres

# Redis Configuration (Upstash or Redis URI, supports rediss:// for TLS)
REDIS_URL=rediss://default:[YOUR-UPSTASH-PASSWORD]@[YOUR-UPSTASH-ENDPOINT]:6379

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# CORS allowed origins (comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security & Rate Limiting Rules
REPLAY_TOLERANCE_SECONDS=300
SLOT_10_COOLDOWN_HOURS=168
